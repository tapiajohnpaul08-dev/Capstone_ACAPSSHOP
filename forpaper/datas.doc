<tr><td>driverDetails</td><td>Subdoc</td><td>No</td><td>—</td><td>See D.7.4.</td></tr>
<tr><td>itemPhotos</td><td>Array&lt;String&gt;</td><td>No</td><td>[]</td><td>Cloudinary URLs of the customer's own item.</td></tr>
<tr><td>isCartOrder</td><td>Boolean</td><td>No</td><td>false</td><td>Whether it originated from cart checkout.</td></tr>
<tr><td>source</td><td>String</td><td>No</td><td>—</td><td>Order source.</td></tr>
<tr><td>orderedBy</td><td>String</td><td>No</td><td>—</td><td>Ref to Customer._id (stored as string).</td></tr>
<tr><td>orderedById</td><td>String</td><td>No</td><td>—</td><td>Alias.</td></tr>
<tr><td>expectedDelivery</td><td>Date</td><td>Yes</td><td>—</td><td>Expected delivery date.</td></tr>
<tr><td>preferredDate</td><td>Date</td><td>No</td><td>—</td><td>Customer's preferred date.</td></tr>
<tr><td>fromCustomerToCompanyDeliveryDate</td><td>Date</td><td>No</td><td>null</td><td>Own-cups drop-off date.</td></tr>
<tr><td>dropOffStatus</td><td>String (enum)</td><td>No</td><td>Pending</td><td>Pending or Received.</td></tr>
<tr><td>orderedAt</td><td>Date</td><td>No</td><td>now</td><td>Order date.</td></tr>
<tr><td>createdAt</td><td>Date</td><td>Auto</td><td>now</td><td>Creation timestamp.</td></tr>
