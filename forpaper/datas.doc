<tr><td>updatedBy</td><td>String</td><td>No</td><td>—</td><td>Admin name.</td></tr>
<tr><td>createdByAdmin</td><td>Boolean</td><td>No</td><td>false</td><td>Walk-in order flag.</td></tr>
