/* ═══════════════════════════════════════════════════════════
   BOOKTABS-STYLE TABLE
   • Header row: top + bottom border only
   • Body rows: no borders
   • Last row: bottom border only
   • No vertical lines anywhere
   ═══════════════════════════════════════════════════════════ */
table {
  border-collapse: collapse;
  width: 100%;
  font-family: "Times New Roman", serif;
